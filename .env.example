# Copy this file to `.env.local` and fill it in. These are read at build time,
# so a change requires restarting `next dev` or rebuilding.
#
# Every value is optional — anything left unset simply isn't rendered, so the
# site never shows a dead link or an empty control.

# Canonical site URL, no trailing slash (e.g. https://vishalgowda.com).
# Used to build absolute URLs for link previews. Unset: falls back to localhost,
# which makes preview images fail on the deployed site — set this in production.
SITE_URL=

# Public link to your resume (Google Drive, Dropbox, a hosted PDF, etc).
# Unset: the "Get my resume" button is not rendered.
RESUME_PUBLIC_LINK=

# Email, split in two so the full address is never rendered into the HTML.
# For "you@example.com": USER=you and DOMAIN=example.com
# Unset: the "Copy email" control is not rendered.
CONTACT_EMAIL_USER=
CONTACT_EMAIL_DOMAIN=

# Unset: the LinkedIn link is not rendered.
LINKEDIN_URL=
